# Merge this location into the existing HTTPS server block for YOUR_DOMAIN.
# Preserve the existing certificate directives and HTTP-to-HTTPS redirect.
# This example assumes Nginx runs on the VPS host, not in another container.
location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
}
