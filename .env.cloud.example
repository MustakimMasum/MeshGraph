# A hostname only, without https:// or a path. Point its DNS to the server first.
DOMAIN=meshgraph.example.com
# Optional contact for OpenAlex requests.
OPENALEX_EMAIL=
# Only used with docker-compose.vps.yml; bind to loopback for a host reverse proxy.
GATEWAY_PORT=3000
# Reduce to 1 if the Rust/WASM build runs out of memory.
CARGO_BUILD_JOBS=2
# Exact official database image verified for this release. Upgrade deliberately.
OXIGRAPH_IMAGE=ghcr.io/oxigraph/oxigraph@sha256:7532c1f9aa5f28c0dc6a4243198f7f6144017fab7429bf6c164a89fec9411767
