unt\": 0, \"id\": \"9936dee7-5fd0-474e-9bb7-ba90340b6f5c\", \"kind\": 1, \"notes\": \"Proc. 4th AIAA Computers in Aerospace Conf. AIAA; 1981 October. With Robert E. Holzman.\\n\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2026-06-20T20:55:04.785572\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2026-06-20T20:52:29.849507\", \"Id\": \"9936dee7-5fd0-474e-9bb7-ba90340b6f5c\", \"Kind\": 1, \"ModificationDateTime\": \"2026-06-20T20:55:13.790897\", \"Name\": \"Computer Graphics for Space Simulation\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:True:False:0:\"}, \"tags\": [], \"title\": \"Computer Graphics for Space Simulation\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"9a5c3d69-af1a-5347-82b3-6cfb951f0d5c\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2020-12-06T00:51:58.671257\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2016-07-08T01:54:24.376\", \"Id\": \"9a5c3d69-af1a-5347-82b3-6cfb951f0d5c\", \"Kind\": 1, \"LinksModificationDateTime\": \"2016-07-25T06:01:58.62\", \"ModificationDateTime\": \"2016-07-08T01:54:24.376\", \"Name\": \"Process\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:False:False:0:\"}, \"tags\": [\"What\"], \"title\": \"Process\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"9b66e54b-a638-595e-baf5-5944b531a360\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2017-03-14T05:43:35.624\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2016-07-08T02:25:39.296\", \"Id\": \"9b66e54b-a638-595e-baf5-5944b531a360\", \"Kind\": 1, \"LinksModificationDateTime\": \"2016-07-08T02:25:39.313\", \"ModificationDateTime\": \"2017-03-14T05:43:38.58\", \"Name\": \"manual intervalometer\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:False:False:0:\"}, \"tags\": [], \"title\": \"manual intervalometer\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"9c4823dd-371d-4a2a-876b-232af3082d19\", \"kind\": 1, \"notes\": \"Proc. 4th Intl. Conf. on Software Engineering. Munich, Germany, IEEE; ACM-SIGSOFT; 1979 September.\\n\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2026-06-20T20:55:41.78304\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2021-03-29T16:47:29.907637\", \"Id\": \"9c4823dd-371d-4a2a-876b-232af3082d19\", \"Kind\": 1, \"ModificationDateTime\": \"2026-06-20T20:55:58.656936\", \"Name\": \"An Interactive FORTRAN Structuring Aid\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:True:False:0:\", \"TypeId\": \"21a84dae-f3bb-4cce-a625-145afa13f914\"}, \"tags\": [], \"title\": \"An Interactive FORTRAN Structuring Aid\", \"topic\": \"Paper\", \"types\": [\"Paper\"], \"year\": null}, {\"citationCount\": 0, \"id\": \"9c4d6bf8-6c2f-56a2-9241-f74f32108da7\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2018-03-12T00:42:59.651\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2016-07-08T02:23:13.496\", \"Id\": \"9c4d6bf8-6c2f-56a2-9241-f74f32108da7\", \"Kind\": 1, \"LinksModificationDateTime\": \"2016-07-08T02:23:13.516\", \"ModificationDateTime\": \"2018-03-12T00:43:03.988\", \"Name\": \"Matrix 2000 film recorder\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:False:False:0:\"}, \"tags\": [], \"title\": \"Matrix 2000 film recorder\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"9fad53b4-243e-5cee-9ebc-7cb006496903\", \"kind\": 1, \"notes\": \"We prowled the JPL campus in the daytime too. David and I happened onto an amazing event in a parking lot. A group of young people was fastening a beer keg to a large dish antenna. They turned out to be Explorer Scouts doing a good deed. JPL had donated the dish antenna to them. My memory says it was 10-15 feet across, but that's not reliable. They had discovered somehow that people on Pitcairn Island needed power or fresh water or something else that the keg-dish contraption could supply using the sun. The beer keg served as a condenser I think. Yes, Pitcairn Island, where Fletcher Christian and fellow mutineers settled after the infamous Mutiny on the Bounty. These island people were their descendants. The Scouts' problem as I recall was how to get the beast to Pitcairn Island. I don't know if they ever succeeded.\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2025-11-11T01:44:22.986582\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2017-03-14T05:26:48\", \"Id\": \"9fad53b4-243e-5cee-9ebc-7cb006496903\", \"Kind\": 1, \"LinksModificationDateTime\": \"2017-03-14T05:28:31\", \"ModificationDateTime\": \"2017-03-14T05:26:48\", \"Name\": \"Explorer Scouts\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:True:False:0:\", \"TypeId\": \"97dc7875-cd9c-5ad0-b94c-00967b0c39a9\"}, \"tags\": [], \"title\": \"Explorer Scouts\", \"topic\": \"anecdote\", \"types\": [\"anecdote\"], \"year\": null}, {\"citationCount\": 0, \"id\": \"a20daa5c-90b5-5058-801a-fea5d66026