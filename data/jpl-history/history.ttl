IsWallpaper\": false, \"Location\": \"Icon.png\", \"ModificationDateTime\": \"2020-08-14T20:55:20.67225\", \"Name\": \"Icon.png\", \"NoteType\": 0, \"Position\": 0.0, \"SourceId\": \"304af362-3c95-52bf-9a24-71eace44fbe3\", \"SourceType\": 2, \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"Type\": 5}, \"status\": \"available\", \"text\": \"\", \"type\": 5}, {\"asset\": null, \"id\": \"e553126a-2c68-56c0-a67d-18cfaf430bab\", \"location\": \"notes.html\", \"name\": \"notes.html\", \"owner\": \"31673b0b-95dd-5773-a31a-3fe10f076a07\", \"raw\": {\"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2016-09-06T02:46:57.416\", \"DataLength\": 215, \"Id\": \"e553126a-2c68-56c0-a67d-18cfaf430bab\", \"IsAiScriptsFile\": false, \"IsBrainAttachment\": false, \"IsBrainIcon\": false, \"IsIcon\": false, \"IsKeyboardShortcutsFile\": false, \"IsToolbarConfigFile\": false, \"IsWallpaper\": false, \"Location\": \"notes.html\", \"ModificationDateTime\": \"2016-09-06T02:46:57.416\", \"NoteType\": 2, \"Position\": 0.0, \"SourceId\": \"31673b0b-95dd-5773-a31a-3fe10f076a07\", \"SourceType\": 2, \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"Type\": 4}, \"status\": \"available\", \"text\": \"people would come to see Jim's amazing graphics, but spend a lot of time watching the blinking lights on the PDP-11 front panel, especially after I wrote that program to download and play arbitrary patterns\", \"type\": 4}, {\"asset\": null, \"id\": \"e7d26a8e-f60d-5cea-adaf-baf267b609e9\", \"location\": \"http://voyager.jpl.nasa.gov/mission/timeline.html?linkId=34589454\", \"name\": \"The Interstellar Mission\", \"owner\": \"85143c27-1f35-5a31-9475-11cebd0ea97c\", \"raw\": {\"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\"