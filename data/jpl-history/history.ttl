20T02:57:18.581\", \"Id\": \"3e888040-915a-557a-a6cc-7467b826b297\", \"Kind\": 4, \"LinksModificationDateTime\": \"2016-08-30T01:42:05.961\", \"ModificationDateTime\": \"2016-07-20T02:57:18.581\", \"Name\": \"When\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"8::0:False:False:0:\"}, \"tags\": [], \"title\": \"When\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"40dd2d93-3b5f-5be3-9b7a-15735a3dc31e\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2026-06-20T20:41:21.854822\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2016-07-15T19:20:32\", \"Id\": \"40dd2d93-3b5f-5be3-9b7a-15735a3dc31e\", \"Kind\": 1, \"LinksModificationDateTime\": \"2017-03-14T05:37:14.25\", \"ModificationDateTime\": \"2026-06-20T20:41:25.301514\", \"Name\": \"Charles \\u201cCharlie\\u201d Kohlhase\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"TagIds\": [], \"ThoughtIconInfo\": \"3:en.wikipedia.org:1:False:False:0:\", \"TypeId\": \"a5d15278-afd4-5b9d-ad04-6aaf3243f36c\"}, \"tags\": [], \"title\": \"Charles \\u201cCharlie\\u201d Kohlhase\", \"topic\": \"Person\", \"types\": [\"Person\"], \"year\": null}, {\"citationCount\": 0, \"id\": \"41119fab-5a56-5e08-8cda-c82e90401aee\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2018-09-02T05:08:31.705\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2017-09-28T03:24:04.8\", \"Id\": \"41119fab-5a56-5e08-8cda-c82e90401aee\", \"Kind\": 1, \"LinksModificationDateTime\": \"2017-09-28T03:24:43.863\", \"ModificationDateTime\": \"2018-06-13T04:48:13.19\", \"Name\": \"Videos\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:False:False:0:\"}, \"tags\": [], \"title\": \"Videos\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"4169bdf5-bb51-58c3-8408-b108bed3a3c5\", \"kind\": 1, \"notes\": \"I had to learn how an actual galaxy works. To my dismay I learned that a star went supernova about once every thousand years. What this meant for my simulation was that it would change everything. I knew that Sagan and everybody else expected the graphic to be a fairly accurate spiral of a great many point spots (the stars) spinning slowly and majestically for a few seconds. A galaxy is a truly monstrous thing. If I sped up time sufficiently that the galaxy spun solemnly during those few seconds, then the number of supernovas going off would make the galaxy sparkle. The thought of trying to explain this to Sagan, getting him to rewrite the (one-line) script, and still delivering the piece on time daunted me. So much so that I buried the glittering supernova vision and delivered (with much help from Blinn) the desired staid but majestic spiral galaxy. I wish I had stuck with the supernova version. Nobody has done it yet I think.\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2017-09-17T19:46:15.296\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2017-03-14T05:23:46\", \"Id\": \"4169bdf5-bb51-58c3-8408-b108bed3a3c5\", \"Kind\": 1, \"LinksModificationDateTime\": \"2017-03-14T05:27:39\", \"ModificationDateTime\": \"2017-03-14T05:23:46\", \"Name\": \"a galaxy for Man and the Cosmos\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:True:False:0:\", \"TypeId\": \"97dc7875-cd9c-5ad0-b94c-00967b0c39a9\"}, \"tags\": [], \"title\": \"a galaxy for Man and the Cosmos\", \"topic\": \"anecdote\", \"types\": [\"anecdote\"], \"year\": null}, {\"citationCount\": 0, \"id\": \"438ea03c-2ab1-5f55-a681-4cd21cda0a02\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2020-08-28T05:48:35.600305\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2016-07-31T21:50:03.398\", \"Id\": \"438ea03c-2ab1-5f55-a681-4cd21cda0a02\", \"Kind\": 1, \"LinksModificationDateTime\": \"2017-03-16T00:21:06.045\", \"ModificationDateTime\": \"2020-08-28T05:48:40.760955\", \"Name\": \"Charlie \\\"save\\\" of VGR1J encounter\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:False:False:0:\"}, \"tags\": [], \"title\": \"Charlie \\\"save\\\" of VGR1J encounter\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"44848ca6-7731-4c72-83c2-f9509d0dfd2e\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2021-01-17T19:12:22.578719\", \"BrainId\": \"ebe741c3-71fe-005e-0a17-062a53c5f110\", \"CreationDateTime\": \"2021-01-17T19:12:08.705188\", \"Id\": \"44848ca6-7731-4c72-83c2-f9509d0dfd2e\", \"Kind\": 1, \"ModificationDateTime\": \"2021-01-17T19:12:08.705188\", \"Name\": \"Julian and Steve call Bob a clumsy oaf\", \"SyncSentId\": \"0cbcc841-7929-46e1-a3af-12c9f0d0c151\", \"SyncUpdateDateTime\": \"2025-07-06T19:25:39.806487\", \"SyncUpdateId\": \"d40aca28-d443-4278-bae2-096e23692407\", \"TagIds\": [], \"ThoughtIconInfo\": \"1::0:False:False:0:\"}, \"tags\": [], \"title\": \"Julian and Steve call Bob a clumsy oaf\", \"topic\": \"Unclassified\", \"types\": [], \"year\": null}, {\"citationCount\": 0, \"id\": \"46bc0876-bfbe-538a-8d9e-5e413421085e\", \"kind\": 1, \"notes\": \"\", \"raw\": {\"ACType\": 0, \"ActivationDateTime\": \"2017-09-28T03:18:11.439\", \"BrainId\": \