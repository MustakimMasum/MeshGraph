@prefix ex: <http://example.org/cadmus/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:SojournerRover
    ex:hasPart ex:BodyAssembly, ex:LeftSuspension, ex:RightSuspension,
        ex:WheelFrontLeft, ex:WheelMiddleLeft, ex:WheelRearLeft,
        ex:WheelFrontRight, ex:WheelMiddleRight, ex:WheelRearRight,
        ex:Drill .

ex:BodyAssembly
    ex:offsetX "0.0"^^xsd:decimal ;
    ex:offsetY "-0.3"^^xsd:decimal ;
    ex:offsetZ "0.0"^^xsd:decimal .

ex:LeftSuspension
    ex:offsetX "-3.0"^^xsd:decimal ;
    ex:offsetY "-0.9"^^xsd:decimal ;
    ex:offsetZ "0.0"^^xsd:decimal .

ex:RightSuspension
    ex:offsetX "3.0"^^xsd:decimal ;
    ex:offsetY "-0.9"^^xsd:decimal ;
    ex:offsetZ "0.0"^^xsd:decimal .

ex:WheelFrontLeft ex:offsetX "-4.3"^^xsd:decimal ; ex:offsetY "-1.0"^^xsd:decimal ; ex:offsetZ "-1.7"^^xsd:decimal .
ex:WheelMiddleLeft ex:offsetX "-4.3"^^xsd:decimal ; ex:offsetY "-1.0"^^xsd:decimal ; ex:offsetZ "0.0"^^xsd:decimal .
ex:WheelRearLeft ex:offsetX "-4.3"^^xsd:decimal ; ex:offsetY "-1.0"^^xsd:decimal ; ex:offsetZ "1.7"^^xsd:decimal .
ex:WheelFrontRight ex:offsetX "4.3"^^xsd:decimal ; ex:offsetY "-1.0"^^xsd:decimal ; ex:offsetZ "-1.7"^^xsd:decimal .
ex:WheelMiddleRight ex:offsetX "4.3"^^xsd:decimal ; ex:offsetY "-1.0"^^xsd:decimal ; ex:offsetZ "0.0"^^xsd:decimal .
ex:WheelRearRight ex:offsetX "4.3"^^xsd:decimal ; ex:offsetY "-1.0"^^xsd:decimal ; ex:offsetZ "1.7"^^xsd:decimal .
ex:Drill ex:offsetX "0.0"^^xsd:decimal ; ex:offsetY "0.0"^^xsd:decimal ; ex:offsetZ "-3.2"^^xsd:decimal .
